<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Scope nuget sources for the api/ tree to nuget.org only so restore works
       on any machine (CI runners, fresh clones) regardless of user-global feeds. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
